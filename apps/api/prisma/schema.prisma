// AI SalesOS — Prisma schema
// Multi-tenant: every business table carries organizationId (PRD §22).
// Sprint 1-2 scope (PRD §24): Organization, Users, Auth, Leads, Pipeline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE_TRIAL
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  ADMIN
  OWNER
  SALES_MANAGER
  SALES_EXECUTIVE
  FIELD_SALES_EXECUTIVE
}

enum LeadSource {
  WHATSAPP
  WEBSITE_FORM
  INDIAMART
  JUSTDIAL
  META_ADS
  GOOGLE_ADS
  REFERRAL
  MANUAL
  IMPORT
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/// A tenant: one MSME/company using AI SalesOS (PRD §4.1 Organization module).
model Organization {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  plan      SubscriptionPlan @default(FREE_TRIAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Meta WhatsApp Business Account phone_number_id — routes inbound webhook
  /// payloads to this org (PRD §5 WhatsApp CRM). Null until connected.
  whatsappPhoneNumberId String? @unique

  users             User[]
  leads             Lead[]
  customers         Customer[]
  pipelineStages    PipelineStage[]
  tasks             Task[]
  conversations     Conversation[]
  messages          Message[]
  messageTemplates  MessageTemplate[]
  products          Product[]
  quotations        Quotation[]
  visits            Visit[]

  @@map("organizations")
}

/// PRD §4.2 User Management — Admin/Owner/Sales Manager/Sales Executive/Field Sales Executive.
model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole @default(SALES_EXECUTIVE)
  isActive     Boolean  @default(true)

  otpCode      String?
  otpExpiresAt DateTime?

  /// TOTP 2FA (PRD §22: "optional 2FA for admins") — twoFactorSecret is encrypted at rest
  /// (see common/crypto.util.ts) and only set once; twoFactorEnabled flips true after the user
  /// proves they scanned it by submitting one valid code (see AuthService.enableTwoFactor).
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads     Lead[] @relation("LeadAssignee")
  assignedTasks     Task[] @relation("TaskAssignee")
  sentMessages      Message[] @relation("MessageSender")
  createdQuotations Quotation[] @relation("QuotationCreator")
  visits            Visit[] @relation("VisitUser")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

/// PRD §4.4 Pipeline Management — configurable Kanban stages per org.
model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  order    Int
  isClosed Boolean @default(false)

  leads Lead[]

  @@unique([organizationId, order])
  @@index([organizationId])
  @@map("pipeline_stages")
}

/// PRD §4.3 Lead Management + §6 AI Lead Scoring.
model Lead {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User? @relation("LeadAssignee", fields: [assignedToId], references: [id])

  pipelineStageId String?
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id])

  name        String
  companyName String?
  phone       String
  email       String?

  source      LeadSource @default(MANUAL)
  status      LeadStatus @default(NEW)
  temperature LeadTemperature @default(COLD)
  score       Int @default(0) // AI lead score 0-100 (PRD §6) — set by AiService, never user-edited

  /// PRD §11 AI Sales Assistant — a cached AI-generated summary; regenerated on demand
  /// (see AiService.summarizeLead), not recomputed automatically.
  aiSummary            String?
  aiSummaryGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  conversations Conversation[]
  quotations    Quotation[]
  visits        Visit[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("leads")
}

/// PRD §4.7 Customer Management — a Lead becomes a Customer once won.
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  companyName String?
  phone       String
  email       String?

  healthScore Int @default(100) // PRD §10 Customer Health Score

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  quotations    Quotation[]
  visits        Visit[]

  @@index([organizationId])
  @@map("customers")
}

/// PRD §4.10 Task & Follow-ups — reminders, optionally tied to a lead.
model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedToId String
  assignedTo   User @relation("TaskAssignee", fields: [assignedToId], references: [id])

  title       String
  notes       String?
  dueAt       DateTime
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, status])
  @@index([leadId])
  @@map("tasks")
}

/// PRD §5 WhatsApp CRM — one thread per phone number, auto-linked to a lead/customer when possible.
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  phone String

  leadId String?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now())
  /// Timestamp of the most recent customer-initiated (INBOUND) message — drives the
  /// WhatsApp Cloud API 24-hour customer service window: outside it, only an approved
  /// template message can reopen the conversation (Meta policy, see ConversationsService).
  lastInboundMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

/// A single inbound or outbound WhatsApp message within a Conversation.
model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction    MessageDirection
  type         MessageType @default(TEXT)
  body         String // caption/text; may be empty for media-only messages
  status       MessageStatus @default(QUEUED)
  externalId   String? // provider (e.g. Meta) message id
  templateName String? // set when sent from a MessageTemplate

  /// Present when type != TEXT. mediaProviderId is the WhatsApp provider's media id
  /// (used to fetch/stream the file on demand — see WhatsApp media proxy endpoint);
  /// mediaUrl is used instead for dev/stub-provider messages that reference a plain URL.
  mediaProviderId String?
  mediaUrl        String?
  mediaMimeType   String?

  sentById String?
  sentBy   User? @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([conversationId])
  @@map("messages")
}

/// PRD §5 WhatsApp CRM — reusable message templates for quick replies/outreach.
model MessageTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  body     String // may contain {{1}}, {{2}} placeholders
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("message_templates")
}

/// PRD §9 Quotation Management — a catalog item that can be added as a quotation line.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  sku         String?
  description String?
  unit        String  @default("pcs") // e.g. pcs, kg, box — free text, India MSME catalogs vary widely
  unitPrice   Decimal @db.Decimal(12, 2)
  /// GST rate applied by default when this product is added to a quotation (India-specific, PRD §9).
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationItems QuotationItem[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("products")
}

/// PRD §9 Quotation Management — create, send, track, share quotations via WhatsApp/Email.
model Quotation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Sequential per-org display number, e.g. "Q-0001" — see QuotationsService.
  number String

  leadId String?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("QuotationCreator", fields: [createdById], references: [id])

  status     QuotationStatus @default(DRAFT)
  validUntil DateTime?
  notes      String?

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuotationItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("quotations")
}

/// A single priced line on a Quotation. description/unitPrice/taxRatePercent are a snapshot
/// taken from Product at add-time (editable per line) so later catalog price changes don't
/// retroactively alter quotations already sent to a customer.
model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  description    String
  quantity       Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  /// quantity * unitPrice, pre-tax.
  lineTotal      Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

enum AiProviderName {
  ANTHROPIC
  OPENAI
  GEMINI
}

/// A platform operator account (this SaaS's own team) — entirely separate from
/// Organization/User. Cannot be created via the public /auth/register flow and carries no
/// organizationId; it is the only identity allowed to manage cross-tenant platform settings
/// (currently: which AI provider + API key every organization's AI features run on). See
/// PlatformAuthService for how the first one is bootstrapped from env vars.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

/// One row per provider so a PlatformAdmin can pre-configure several providers' API keys
/// and switch PlatformSettings.activeAiProvider between them without re-entering keys.
/// apiKey is encrypted at rest (see common/crypto.util.ts) — never returned in full by the API.
model AiProviderConfig {
  provider  AiProviderName @id
  apiKey    String
  model     String?

  updatedAt DateTime @updatedAt

  @@map("ai_provider_configs")
}

/// Singleton row (id is always "singleton") holding platform-wide settings. Currently just
/// the active AI provider; null means every organization's AI features fall back to the
/// deterministic rule-based stub (see StubAiProvider) — never OWNER/ADMIN-configurable.
model PlatformSettings {
  id               String          @id @default("singleton")
  activeAiProvider AiProviderName?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

/// PRD §8 Sales Force Automation — a field rep's GPS-stamped visit to a lead/customer (or a
/// standalone location check-in). checkOutAt null means the visit is still in progress.
model Visit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  userId String
  user   User @relation("VisitUser", fields: [userId], references: [id])

  /// Client-generated idempotency key — lets a check-in queued offline (see the web app's
  /// IndexedDB outbox) be retried safely without creating a duplicate visit if the first
  /// attempt actually reached the server before the connection dropped.
  clientId String?

  purpose String
  notes   String?

  checkInAt  DateTime @default(now())
  checkInLat Decimal  @db.Decimal(9, 6)
  checkInLng Decimal  @db.Decimal(9, 6)

  checkOutAt    DateTime?
  checkOutLat   Decimal?  @db.Decimal(9, 6)
  checkOutLng   Decimal?  @db.Decimal(9, 6)
  checkOutNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, clientId])
  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([leadId])
  @@map("visits")
}
