# PostgreSQL connection (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://salesos:salesos_dev_password@localhost:5432/ai_salesos?schema=public"

# API server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# WhatsApp — defaults to the stub provider (logs only, no real account needed for dev).
# Set WHATSAPP_PROVIDER=meta plus the two vars below to send/receive via a live WABA number
# (see README "Connecting a real WhatsApp Business number").
WHATSAPP_PROVIDER=stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Quotations — publicly reachable base URL (including the /api prefix) used to build the
# signed WhatsApp-sharing PDF link; only matters once this API is deployed somewhere Meta's
# servers can reach (localhost links won't resolve for a real WhatsApp Business account).
PUBLIC_API_URL=http://localhost:4000/api
QUOTATION_LINK_SECRET=

# AI (lead scoring, summaries, follow-up + reply suggestions) — defaults to a deterministic,
# rule-based stub so these features work with no API key in dev. Set AI_PROVIDER=anthropic
# plus ANTHROPIC_API_KEY to use a real model.
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
