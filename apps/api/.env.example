# PostgreSQL connection (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://salesos:salesos_dev_password@localhost:5432/ai_salesos?schema=public"

# API server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# WhatsApp — defaults to the stub provider (logs only, no real account needed for dev).
# Set WHATSAPP_PROVIDER=meta plus the two vars below to send/receive via a live WABA number
# (see README "Connecting a real WhatsApp Business number").
WHATSAPP_PROVIDER=stub
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Quotations — publicly reachable base URL (including the /api prefix) used to build the
# signed WhatsApp-sharing PDF link; only matters once this API is deployed somewhere Meta's
# servers can reach (localhost links won't resolve for a real WhatsApp Business account).
PUBLIC_API_URL=http://localhost:4000/api
QUOTATION_LINK_SECRET=

# AI (lead scoring, summaries, follow-up + reply suggestions) — defaults to a deterministic,
# rule-based stub with no API key needed. The active provider + its API key are NOT set here:
# they're configured at runtime by a PlatformAdmin from /platform/ai-settings (this SaaS's own
# team only — no Organization Owner/Admin can reach that surface). PLATFORM_SECRET encrypts
# those stored API keys at rest; change it (and re-save the keys) for a real deployment.
PLATFORM_SECRET=dev-secret-change-me

# PlatformAdmin auth — a separate identity from Organization users, signed with its own
# secret (never reuse JWT_SECRET here). The first PlatformAdmin account is bootstrapped from
# PLATFORM_ADMIN_EMAIL/PLATFORM_ADMIN_PASSWORD on first boot if the platform_admins table is
# empty; unset them (or just don't reuse this password) once you've logged in.
PLATFORM_JWT_SECRET=dev-platform-secret-change-me
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
